# Copie este modelo para .env ao configurar uma nova instalação.
# Preencha os valores somente no .env local. Nunca coloque valores reais aqui.

# banco de dados (Neon) e chave que assina a sessão
DATABASE_URL=
SECRET_KEY=

# Twilio Verify (segundo fator do login)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# e-mail da recuperação de senha (Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SafeClick

# endereço público usado nos links enviados por e-mail
APP_BASE_URL=http://127.0.0.1:5000

# use true somente quando o site estiver publicado em HTTPS
SESSION_COOKIE_SECURE=false