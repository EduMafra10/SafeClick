# Modelo das variáveis de ambiente do SafeClick.
# 1. Copie este arquivo para .env (o .env não vai para o Git).
# 2. Troque os valores de exemplo pelos valores reais do seu ambiente.
# As variáveis são lidas em safeclick/config.py.

### Aplicação ###
# desenvolvimento (local) ou producao (site publicado)
APP_ENV=desenvolvimento
# chave aleatória que assina a sessão e o token CSRF (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# endereço usado nos links enviados por e-mail (em produção, https://)
APP_BASE_URL=http://127.0.0.1:5000
# ative após aplicar a migração e validar a coleta e o descarte de avaliações
AVALIACOES_ATIVAS=false

### Persistência de dados (PostgreSQL no Neon) ###
DATABASE_URL=postgresql://USUARIO:SENHA@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

### Segundo fator do login (Twilio Verify) ###
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=troque-pelo-auth-token-da-twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

### E-mail SMTP (recuperação de senha) ###
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=safeclickpfc@gmail.com
# senha de app do Gmail (16 letras), não a senha da conta
SMTP_PASSWORD=troque-pela-senha-de-app
SMTP_FROM_NAME=SafeClick
# e-mail exibido para quem perdeu o acesso ao autenticador
SUPORTE_EMAIL=safeclickpfc@gmail.com

### Cookie de sessão ###
# true somente com HTTPS; em producao é sempre true
SESSION_COOKIE_SECURE=false
